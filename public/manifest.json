{
  "manifest_version": 3,
  "name": "Local AI Browser Assistant",
  "version": "0.1.0",
  "description": "On-device AI in the side panel via Chrome Built-in AI (Gemini Nano).",
  "minimum_chrome_version": "138",
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
